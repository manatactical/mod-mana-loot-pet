#
# mod-mana-loot-pet configuration
#
# The player's vanity companion (a non-combat pet) walks to a fresh corpse and loots it. Only a
# creature whose sole loot recipient is the killing player is served, so group loot rules and rolls
# are never bypassed, and one corpse is walked at a time -- a pull that kills several creatures queues
# them and the pet visits each in turn.
#

[worldserver]

########################################
# The companion fetch
########################################

#
#    ManaLootPet.Enable
#        Description: Enable the module. With 0 no new fetch is started and the companion behaves
#                     exactly as before. A fetch already in flight is left to finish.
#        Default:     1 - Enabled
#                     0 - Disabled
#

ManaLootPet.Enable = 1

#
#    ManaLootPet.LootDistance
#        Description: How close, in yards, the companion must get to the corpse before the loot is
#                     taken. This is what makes the fetch visible: the pet has to actually reach the
#                     corpse. Raise it and the loot moves while the pet is still walking; lower it
#                     and the pet must stand on the body. It also caps how far away the pet aims
#                     when sent over (60% of it, never under half a yard). Values below 0.5 are
#                     raised to 0.5.
#        Default:     1.5
#

ManaLootPet.LootDistance = 1.5

#
#    ManaLootPet.MaxDistance
#        Description: How close, in yards, the player must be to a corpse before the companion is sent
#                     over. A kill further away only queues the corpse: the pet keeps following the
#                     player and is sent the moment the gap is closed, so it never walks off across
#                     the zone and times out. 0 disables the check and sends the pet from anywhere.
#        Default:     40
#

ManaLootPet.MaxDistance = 40

#
#    ManaLootPet.ReachTimeoutMs
#        Description: How long, in milliseconds, the companion may spend walking to one corpse
#                     before that corpse is dropped and the next one in the queue is tried. Covers the
#                     companion getting stuck, rooted or killed on the way, and a corpse that has
#                     already decayed. The clock starts when the pet is actually sent, so a corpse
#                     waiting on MaxDistance does not consume it. Values below 1000 are raised to 1000.
#        Default:     8000
#

ManaLootPet.ReachTimeoutMs = 8000

#
#    ManaLootPet.LootMoney
#        Description: Take the corpse's money for the player.
#        Default:     1 - Enabled
#                     0 - Disabled
#

ManaLootPet.LootMoney = 1

#
#    ManaLootPet.LootItems
#        Description: Take the corpse's items for the player. Quest items, conditional drops and
#                     rolled items are always left on the corpse for the player to hand-loot.
#        Default:     1 - Enabled
#                     0 - Disabled
#

ManaLootPet.LootItems = 1

#
#    ManaLootPet.MailWhenBagsFull
#        Description: When an item does not fit in the player's bags, mail it through the Postmaster
#                     instead of leaving it on the corpse. With 0 the item is left lootable, so the
#                     corpse does not clear until the player makes room and hands it over.
#        Default:     1 - Enabled
#                     0 - Disabled
#

ManaLootPet.MailWhenBagsFull = 1

#
#    ManaLootPet.MaxItemsPerCorpse
#        Description: Most item slots the companion takes (or mails) from one corpse in a single
#                     fetch, so one very rich corpse cannot fill the whole inventory in one tick.
#                     Slots left for the player to hand-loot do not count. Values below 1 are raised
#                     to 1.
#        Default:     20
#

ManaLootPet.MaxItemsPerCorpse = 20

#
#    ManaLootPet.PetIds
#        Description: Creature entries of the companions allowed to fetch loot, comma separated
#                     (for example 34337 for the Postmaster, or 29726/29725 for a pet you own).
#                     Empty means every vanity companion may fetch, which is the default. An id
#                     that is not a number is ignored; a list with no valid id counts as empty.
#        Default:     "" - any companion
#

ManaLootPet.PetIds = ""